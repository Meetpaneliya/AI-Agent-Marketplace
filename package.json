{
  "name": "agentstore",
  "version": "1.0.0",
  "private": true,
  "description": "AI Agent Marketplace",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"web,api\" -c \"cyan,magenta\" \"yarn workspace web dev\" \"yarn workspace api dev\"",
    "dev:web": "yarn workspace web dev",
    "dev:api": "yarn workspace api dev",
    "build": "yarn workspace web build && yarn workspace api build",
    "build:web": "yarn workspace web build",
    "build:api": "yarn workspace api build",
    "lint": "yarn workspace web lint && yarn workspace api lint",
    "typecheck": "yarn workspace api typecheck",
    "db:generate": "yarn workspace api prisma:generate",
    "db:migrate": "yarn workspace api prisma:migrate",
    "db:seed": "yarn workspace api prisma:seed",
    "db:studio": "yarn workspace api prisma:studio",
    "db:push": "yarn workspace api prisma:push",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=20.0.0"
  }
}
