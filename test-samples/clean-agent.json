{
  "name": "Clean Autonomous Lead Outreach Agent",
  "version": "1.0.0",
  "description": "Clean production-ready workflow using environment variables without hardcoded secrets.",
  "nodes": [
    {
      "id": "node-1",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "position": [250, 300],
      "parameters": {
        "path": "lead-intake",
        "httpMethod": "POST"
      }
    },
    {
      "id": "node-2",
      "name": "OpenAI Qualifier",
      "type": "n8n-nodes-base.openAi",
      "position": [450, 300],
      "parameters": {
        "model": "gpt-4o",
        "prompt": "Score lead alignment with target profile",
        "apiKey": "={{$env.OPENAI_API_KEY}}"
      }
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "OpenAI Qualifier",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
